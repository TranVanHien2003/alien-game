; Engine configuration file.
; Sửa qua Project Settings trong Godot hoặc trực tiếp ở đây.

config_version=5

[application]

config/name="Âu Cơ: Con Tàu Thế Hệ"
config/description="Sinh tồn / xây dựng thuộc địa có cốt truyện trên một con tàu thế hệ."
config/version="0.1.0"
run/main_scene="res://scenes/title/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Content="*res://scripts/autoload/content_db.gd"
Game="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom="res://assets/themes/main_theme.tres"

